# MV Finds Frontend — Environment Configuration (Vercel & Local)
# Base URL for canonical links and Open Graph previews
VITE_SITE_URL=https://mv-finds.vercel.app

# Backend API URL (Points to Spring Boot REST API)
# For local development: http://localhost:8080/api
# For production: Set this to your deployed Spring Boot backend URL in Vercel Environment Variables
VITE_API_URL=http://localhost:8080/api

# Development Admin Credentials (Frontend local testing only)
# NOTE: Replace with server-side authentication (e.g., Supabase, Firebase, or Spring Security) before public production deployment.
VITE_ADMIN_EMAIL=admin@mvfinds.in
VITE_ADMIN_PASSWORD=admin123
