# MV Finds Environment Configuration
# Base URL for canonical links and Open Graph tags
VITE_SITE_URL=https://mvfinds.in

# Development Admin Credentials
# NOTE: This frontend credential check is for local development only.
# Replace with proper server-side authentication (e.g. Supabase, Firebase, or Node Auth) before public production deployment.
VITE_ADMIN_EMAIL=admin@mvfinds.in
VITE_ADMIN_PASSWORD=admin123

# Future Email Service (e.g., Mailchimp, ConvertKit, Buttondown, or custom API)
# VITE_NEWSLETTER_ENDPOINT=https://api.yournewsletter.com/subscribe

# Future Contact Form Endpoint (e.g., Formspree or EmailJS)
# VITE_CONTACT_ENDPOINT=https://formspree.io/f/your_form_id

# Future Analytics (e.g., Cloudflare Web Analytics token or Plausible domain)
# VITE_ANALYTICS_ID=
