# MV Finds Spring Boot Backend — Environment Configuration
# Copy this file to .env and configure your PostgreSQL database credentials.

# PostgreSQL Database Connection
DB_URL=jdbc:postgresql://localhost:5432/mv_finds
DB_USERNAME=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD

# Server Port
PORT=8080

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local directory where uploaded product images are saved
UPLOAD_DIR=../public/products
